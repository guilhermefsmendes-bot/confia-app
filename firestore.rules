rules_version = '2';

service cloud.firestore {
  function validReactionTransition(beforeUsers, afterUsers, beforeCount, afterCount, uid) {
    return beforeUsers is list
      && afterUsers is list
      && beforeCount is int
      && afterCount is int
      && (
        (afterUsers == beforeUsers && afterCount == beforeCount)
        || (
          !(uid in beforeUsers)
          && uid in afterUsers
          && afterUsers.size() == beforeUsers.size() + 1
          && afterCount == beforeCount + 1
        )
        || (
          uid in beforeUsers
          && !(uid in afterUsers)
          && afterUsers.size() == beforeUsers.size() - 1
          && afterCount == beforeCount - 1
        )
      );
  }

  function userHasAtMostOneReaction(yellowUsers, greenUsers, redUsers, uid) {
    return yellowUsers is list
      && greenUsers is list
      && redUsers is list
      && (
        !(uid in yellowUsers)
        || (!(uid in greenUsers) && !(uid in redUsers))
      )
      && (
        !(uid in greenUsers)
        || !(uid in redUsers)
      );
  }

  match /databases/{database}/documents {

    match /users/{uid}/devices/{deviceId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['fcmToken','platform','updatedAt','notificationsEnabled','language'])
        && request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() >= 20 && request.resource.data.fcmToken.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.notificationsEnabled is bool
        && request.resource.data.language in ['pt','en','es','fr']
        && request.resource.data.updatedAt == request.time;
    }
    match /users/{uid}/preferences/notifications {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['community','milestones','updatedAt'])
        && request.resource.data.community is bool && request.resource.data.milestones is bool
        && request.resource.data.updatedAt == request.time;
    }
    match /notificationDeliveries/{id} { allow read, write: if false; }

    // Private habit journal. No community access or sensitive analytics payloads.
    match /users/{userId}/habitRecords/{recordId} {
      function owns() { return request.auth != null && request.auth.uid == userId; }
      function quantity(d, key) { return !(key in d) || (d[key] is number && d[key] >= 0 && d[key] <= 1000); }
      function period(d) { return !('period' in d) || d.period in ['morning','lunch','afternoon','evening']; }
      function sample(d) { return d is map && d.keys().hasOnly(['mean','days','moodMean','moodDays']) && d.mean is number && d.mean >= 0 && d.mean <= 250000 && d.days is int && d.days >= 0 && d.days <= 10000 && d.moodMean is number && d.moodMean >= -100 && d.moodMean <= 100 && d.moodDays is int && d.moodDays >= 0 && d.moodDays <= 10000; }
      function foodItem(d) {
        return d.keys().hasOnly(['category','subtype','quantity','unit','servingMl','period','time','size','intensity','caffeine','sugar','deleted'])
          && d.category in ['coffee','fruit','vegetables','soda','water','energy','alcohol','tobacco','fastFood','sweets']
          && (d.subtype == 'unspecified' || (d.category == 'coffee' && d.subtype in ['espresso','short','long','americano','filter','capsule','instant','decaf','other'])
            || (d.category == 'fruit' && d.subtype in ['apple','banana','orange','pear','kiwi','strawberry','berries','grapes','mango','pineapple','peach','melon','watermelon','other'])
            || (d.category == 'vegetables' && d.subtype in ['salad','soup','boiled','grilled','other'])
            || (d.category == 'soda' && d.subtype in ['cocaCola','cocaColaZero','pepsi','pepsiMax','sprite','sevenUp','fanta','guarana','orangeJuice','appleJuice','nectar','iceTea','freshJuice','other'])
            || (d.category == 'water' && d.subtype in ['still','sparkling'])
            || (d.category == 'energy' && d.subtype in ['energy','sugarFree','other'])
            || (d.category in ['alcohol','tobacco'] && d.subtype == 'other')
            || (d.category == 'fastFood' && d.subtype in ['meal','other'])
            || (d.category == 'sweets' && d.subtype in ['occasion','other']))
          && d.quantity is number && d.quantity >= 0
          && d.unit in ['item','portion','cup','can','bottle','ml','occasion','meal']
          && (d.unit == 'ml' ? d.quantity <= 10000 : (d.quantity is int && d.quantity <= 100))
          && d.deleted is bool && period(d)
          && (!('servingMl' in d) || (d.servingMl is int && d.servingMl >= 1 && d.servingMl <= 2000))
          && (!('time' in d) || (d.time is string && d.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]')))
          && (!('size' in d) || d.size in ['small','medium','large'])
          && (!('intensity' in d) || d.intensity in ['mild','medium','strong'])
          && (!('caffeine' in d) || d.caffeine in ['yes','no','unknown'])
          && (!('sugar' in d) || d.sugar in ['yes','no','unknown']);
      }
      function plan(d) {
        return d.keys().hasOnly(['templateId','status','startDate','endDate','pausedAt','pausedDays','gentle','baseline','result'])
          && d.templateId in ['caffeine','hydration','plants','energy','movement','walk','regularity','timing','routine']
          && d.status in ['active','paused','completed','abandoned']
          && d.startDate is string && d.startDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && d.endDate is string && d.endDate.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && d.endDate >= d.startDate
          && d.pausedAt is string && (d.pausedAt == '' || d.pausedAt.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          && d.pausedDays is int && d.pausedDays >= 0 && d.pausedDays <= 10000
          && d.gentle is bool && sample(d.baseline) && (!('result' in d) || sample(d.result));
      }
      function validPayload(r) {
        let d = r.data;
        return d is map && (
          (r.kind == 'habit' && d.keys().hasOnly(['type','name','icon','goal','active','createdAt'])
            && d.type in ['tobacco','coffee','alcohol','social','gaming','sugar','shopping','checking','sleep','custom']
            && d.name is string && d.name.size() <= 60 && (d.type != 'custom' || d.name.size() > 0)
            && d.icon is string && d.icon.size() > 0 && d.icon.size() <= 16
            && d.goal is string && d.goal.size() > 0 && d.goal.size() <= 180
            && d.active is bool && d.createdAt is string)
          || (r.kind == 'settings' && recordId == 'settings' && d.keys().hasOnly(['primaryId']) && d.primaryId is string && d.primaryId.size() <= 100)
          || (r.kind == 'habitLog' && d.keys().hasOnly(['habitId','completed']) && d.habitId is string && d.habitId.size() <= 100 && d.completed is bool)
          || (r.kind == 'restart' && d.keys().hasOnly(['habitId','reason','bestBefore']) && d.habitId is string && d.habitId.size() <= 100 && d.reason in ['once','several','fresh'] && (!('bestBefore' in d) || (d.bestBefore is int && d.bestBefore >= 0)))
          || (r.kind == 'summary' && d.keys().hasOnly(['habitId','best','total','runStart','runEnd','cycleAt','cycleDate']) && d.habitId is string && d.habitId.size() <= 100 && d.best is int && d.best >= 0 && d.total is int && d.total >= 0 && d.runStart is string && d.runStart.size() <= 10 && d.runEnd is string && d.runEnd.size() <= 10 && d.cycleAt is string && d.cycleAt.size() <= 24 && d.cycleDate is string && d.cycleDate.size() <= 10)
          || (r.kind == 'nutrition' && d.keys().size() > 0
            && d.keys().hasOnly(['coffee','energy','soda','water','alcohol','tobacco','fastFood','fruit','vegetables','sweets'])
            && quantity(d,'coffee') && quantity(d,'energy') && quantity(d,'soda') && quantity(d,'water')
            && quantity(d,'alcohol') && quantity(d,'tobacco') && quantity(d,'fastFood') && quantity(d,'fruit') && quantity(d,'vegetables') && quantity(d,'sweets'))
          || (r.kind == 'foodItem' && foodItem(d))
          || (r.kind == 'wellbeingPlan' && plan(d))
          || (r.kind == 'planCheck' && d.keys().hasOnly(['planId','day','outcome']) && d.planId is string && d.planId.size() <= 100 && d.day is int && d.day >= 1 && d.day <= 15 && d.outcome in ['done','notToday'])
          || (r.kind == 'planPreference' && recordId == 'plan_preference' && d.keys().hasOnly(['dismissedUntil']) && d.dismissedUntil is string && d.dismissedUntil.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'))
          || (r.kind == 'exercise' && d.keys().hasOnly(['activity','minutes','intensity','period']) && period(d)
            && d.activity in ['walk','run','gym','bike','swim','sport','yoga','other']
            && d.minutes is int && d.minutes >= 0 && d.minutes <= 1440
            && (!('intensity' in d) || d.intensity in ['light','moderate','intense']))
        );
      }
      function valid() {
        let r = request.resource.data;
        return r.keys().hasOnly(['id','kind','date','updatedAt','timezone','userId','data'])
          && r.id == recordId && r.userId == userId
          && r.date is string && r.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && r.updatedAt is string && r.updatedAt.size() == 24
          && r.timezone is string && r.timezone.size() <= 100
          && validPayload(r);
      }
      allow read, delete: if owns();
      allow create: if owns() && valid();
      allow update: if owns() && valid() && request.resource.data.kind == resource.data.kind
        && request.resource.data.updatedAt >= resource.data.updatedAt;
    }


    function validAcceptedExperienceMatch(chatData) {
      return chatData.keys().hasAny(['matchRequestId'])
        && chatData.matchRequestId is string
        && exists(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId))
        && get(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId)).data.status == 'accepted'
        && get(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId)).data.postId == chatData.postId
        && get(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId)).data.requesterId in chatData.participants
        && get(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId)).data.recipientId in chatData.participants
        && get(/databases/$(database)/documents/communityMatchRequests/$(chatData.matchRequestId)).data.recipientId == chatData.authorId;
    }

    // A listening chat can only be created in the same transaction that
    // claims a waiting request for one eligible volunteer.
    function validListeningSupportMatch(chatData) {
      return chatData.keys().hasAny(['listeningRequestId'])
        && chatData.listeningRequestId is string
        && getAfter(/databases/$(database)/documents/listeningRequests/$(chatData.listeningRequestId)).data.status == 'matched'
        && getAfter(/databases/$(database)/documents/listeningRequests/$(chatData.listeningRequestId)).data.requesterId in chatData.participants
        && getAfter(/databases/$(database)/documents/listeningRequests/$(chatData.listeningRequestId)).data.acceptedBy in chatData.participants
        && getAfter(/databases/$(database)/documents/listeningRequests/$(chatData.listeningRequestId)).data.requesterId == chatData.authorId
        && chatData.postId == 'listen_' + chatData.listeningRequestId;
    }

    // =====================================================
    // PUBLICAÇÕES DA COMUNIDADE
    // =====================================================
    match /posts/{postId} {

      // Utilizadores autenticados podem ler publicações
      allow read: if request.auth != null;

      // Utilizadores autenticados podem criar publicações apenas em seu
      // próprio nome e com um payload limitado/consistente.
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 40
        && request.resource.data.feeling is string
        && request.resource.data.feeling.size() > 0
        && request.resource.data.feeling.size() <= 50
        && (
          !request.resource.data.keys().hasAny(['topic'])
          || (
            request.resource.data.topic is string
            && request.resource.data.topic in [
              'ansiedade',
              'stress',
              'saude-mental',
              'cansaco',
              'solidao',
              'relacoes',
              'trabalho-estudos',
              'familia',
              'sono',
              'autoestima',
              'progresso',
              'outro'
            ]
          )
        )
        && (
          !request.resource.data.keys().hasAny(['experienceTag'])
          || (
            request.resource.data.experienceTag is string
            && request.resource.data.experienceTag in [
              'separation_divorce','grief','loneliness','work_difficulties',
              'parenting','relationship_problems','job_change','sleep_difficulties',
              'stress','panic_attacks','body_sensations','low_self_esteem',
              'caregiving','moving_city','family_problems','rumination',
              'sleep','work','panic','family','relationships'
            ]
          )
        )
        && (
          !request.resource.data.keys().hasAny(['supportMode'])
          || request.resource.data.supportMode in ['share','other_side','seeking_match','give_back']
        )
        && (
          !request.resource.data.keys().hasAny(['circleExpiresAt'])
          || request.resource.data.circleExpiresAt is number
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 220
        && request.resource.data.yellowLikes is int
        && request.resource.data.yellowLikes == 0
        && request.resource.data.greenLikes is int
        && request.resource.data.greenLikes == 0
        && request.resource.data.redLikes is int
        && request.resource.data.redLikes == 0
        && request.resource.data.yellowLikedBy is list
        && request.resource.data.yellowLikedBy.size() == 0
        && request.resource.data.greenLikedBy is list
        && request.resource.data.greenLikedBy.size() == 0
        && request.resource.data.redLikedBy is list
        && request.resource.data.redLikedBy.size() == 0
        && request.resource.data.createdAt is timestamp;

      // Cada utilizador só pode criar/remover a sua própria reação.
      // As contagens têm de acompanhar exatamente a alteração da lista.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'yellowLikes',
            'greenLikes',
            'redLikes',
            'yellowLikedBy',
            'greenLikedBy',
            'redLikedBy'
          ])
        && validReactionTransition(resource.data.yellowLikedBy, request.resource.data.yellowLikedBy, resource.data.yellowLikes, request.resource.data.yellowLikes, request.auth.uid)
        && validReactionTransition(resource.data.greenLikedBy, request.resource.data.greenLikedBy, resource.data.greenLikes, request.resource.data.greenLikes, request.auth.uid)
        && validReactionTransition(resource.data.redLikedBy, request.resource.data.redLikedBy, resource.data.redLikes, request.resource.data.redLikes, request.auth.uid)
        && userHasAtMostOneReaction(
          request.resource.data.yellowLikedBy,
          request.resource.data.greenLikedBy,
          request.resource.data.redLikedBy,
          request.auth.uid
        );

      // O autor pode apagar a própria publicação.
      // Moderadores também podem apagar.
      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.authorId
          || request.auth.token.moderator == true
        );
    }


    // =====================================================
    // INQUERITOS DE EXPERIENCIA DA COMUNIDADE
    // =====================================================
    match /communityPolls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 180
        && request.resource.data.topic is string
        && request.resource.data.options is list
        && request.resource.data.options.size() == 4
        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['options'])
        && request.resource.data.options is list
        && request.resource.data.options.size() == 4
        && request.resource.data.options[0].id == resource.data.options[0].id
        && request.resource.data.options[1].id == resource.data.options[1].id
        && request.resource.data.options[2].id == resource.data.options[2].id
        && request.resource.data.options[3].id == resource.data.options[3].id
        && request.resource.data.options[0].label == resource.data.options[0].label
        && request.resource.data.options[1].label == resource.data.options[1].label
        && request.resource.data.options[2].label == resource.data.options[2].label
        && request.resource.data.options[3].label == resource.data.options[3].label
        && request.resource.data.options[0].count >= resource.data.options[0].count && request.resource.data.options[0].count <= resource.data.options[0].count + 1
        && request.resource.data.options[1].count >= resource.data.options[1].count && request.resource.data.options[1].count <= resource.data.options[1].count + 1
        && request.resource.data.options[2].count >= resource.data.options[2].count && request.resource.data.options[2].count <= resource.data.options[2].count + 1
        && request.resource.data.options[3].count >= resource.data.options[3].count && request.resource.data.options[3].count <= resource.data.options[3].count + 1
        && request.resource.data.options[0].voterIds.hasAll(resource.data.options[0].voterIds)
        && request.resource.data.options[1].voterIds.hasAll(resource.data.options[1].voterIds)
        && request.resource.data.options[2].voterIds.hasAll(resource.data.options[2].voterIds)
        && request.resource.data.options[3].voterIds.hasAll(resource.data.options[3].voterIds)
        && request.resource.data.options[0].voterIds.size() + request.resource.data.options[1].voterIds.size() + request.resource.data.options[2].voterIds.size() + request.resource.data.options[3].voterIds.size()
          == resource.data.options[0].voterIds.size() + resource.data.options[1].voterIds.size() + resource.data.options[2].voterIds.size() + resource.data.options[3].voterIds.size() + 1
        && request.resource.data.options[0].count + request.resource.data.options[1].count + request.resource.data.options[2].count + request.resource.data.options[3].count
          == resource.data.options[0].count + resource.data.options[1].count + resource.data.options[2].count + resource.data.options[3].count + 1
        && !(request.auth.uid in resource.data.options[0].voterIds)
        && !(request.auth.uid in resource.data.options[1].voterIds)
        && !(request.auth.uid in resource.data.options[2].voterIds)
        && !(request.auth.uid in resource.data.options[3].voterIds)
        && (
          request.auth.uid in request.resource.data.options[0].voterIds
          || request.auth.uid in request.resource.data.options[1].voterIds
          || request.auth.uid in request.resource.data.options[2].voterIds
          || request.auth.uid in request.resource.data.options[3].voterIds
        );
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
    }

    // =====================================================
    // EXPERIENCE MATCHING — preferências privadas e pedidos bilaterais
    // =====================================================
    // Profiles for opt-in peer listening. Only the owner can edit their themes.
    match /listeningProfiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['ownerId','active','themes','updatedAt'])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.active is bool
        && request.resource.data.themes is list
        && request.resource.data.themes.size() <= 8
        && request.resource.data.themes.hasOnly(['anxiety','depression','loneliness','stress','relationships','grief','selfEsteem','other'])
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /listeningRequests/{requestId} {
      // Requesters can follow their own request; eligible listeners only see
      // waiting requests for topics they opted into.
      allow get, list: if request.auth != null
        && (
          resource.data.requesterId == request.auth.uid
          || (resource.data.status in ['matched','closed'] && resource.data.acceptedBy == request.auth.uid)
          || (
            resource.data.status == 'waiting'
            && get(/databases/$(database)/documents/listeningProfiles/$(request.auth.uid)).data.active == true
            && resource.data.theme in get(/databases/$(database)/documents/listeningProfiles/$(request.auth.uid)).data.themes
          )
        );

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['requesterId','theme','note','status','acceptedBy','createdAt','expiresAt'])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.theme in ['anxiety','depression','loneliness','stress','relationships','grief','selfEsteem','other']
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 300
        && request.resource.data.status == 'waiting'
        && request.resource.data.acceptedBy == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time;

      allow update: if request.auth != null
        && resource.data.status in ['waiting','matched']
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.theme == resource.data.theme
        && request.resource.data.note == resource.data.note
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && (
          (
            resource.data.status == 'waiting'
            && request.auth.uid == resource.data.requesterId
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','cancelledAt'])
            && request.resource.data.cancelledAt is timestamp
          )
          || (
            resource.data.status == 'waiting'
            && request.auth.uid != resource.data.requesterId
            && request.resource.data.status == 'matched'
            && request.resource.data.acceptedBy == request.auth.uid
            && request.resource.data.matchedAt is timestamp
            // Claiming a request and creating its private chat must be atomic.
            // Otherwise a client could reserve a request without opening a conversation.
            && existsAfter(/databases/$(database)/documents/chats/$('listen_' + requestId))
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.listeningRequestId == requestId
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.postId == 'listen_' + requestId
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.authorId == resource.data.requesterId
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.participants is list
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.participants.size() == 2
            && resource.data.requesterId in getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.participants
            && request.auth.uid in getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','acceptedBy','matchedAt'])
            && resource.data.expiresAt > request.time
            && get(/databases/$(database)/documents/listeningProfiles/$(request.auth.uid)).data.active == true
            && resource.data.theme in get(/databases/$(database)/documents/listeningProfiles/$(request.auth.uid)).data.themes
            && !exists(/databases/$(database)/documents/blocks/$(request.auth.uid + '_' + resource.data.requesterId))
            && !exists(/databases/$(database)/documents/blocks/$(resource.data.requesterId + '_' + request.auth.uid))
          )
          || (
            resource.data.status == 'matched'
            && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.acceptedBy)
            && request.resource.data.status == 'closed'
            && request.resource.data.closedAt is timestamp
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.closedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.closedAt is timestamp
            && !(request.auth.uid in getAfter(/databases/$(database)/documents/chats/$('listen_' + requestId)).data.participants)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','closedAt'])
          )
        );

      // Either participant may remove the request when deleting their account.
      allow delete: if request.auth != null
        && (resource.data.requesterId == request.auth.uid || resource.data.acceptedBy == request.auth.uid);
    }

    match /communityMatchProfiles/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list: if false;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.active is bool
        && request.resource.data.activeTags is list
        && request.resource.data.activeTags.size() <= 3
        && request.resource.data.preference in ['same_now','been_there','either']
        && request.resource.data.conversationMode in ['one_to_one','group','either']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /communityMatchRequests/{requestId} {
      allow get, list: if request.auth != null
        && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);

      allow create: if request.auth != null
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.experienceTag is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.authorId == request.resource.data.recipientId
        && get(/databases/$(database)/documents/posts/$(request.resource.data.postId)).data.experienceTag == request.resource.data.experienceTag
        && get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.active == true
        && request.resource.data.experienceTag in get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.activeTags;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.recipientId
        && resource.data.status == 'pending'
        && request.resource.data.requesterId == resource.data.requesterId
        && request.resource.data.recipientId == resource.data.recipientId
        && request.resource.data.postId == resource.data.postId
        && request.resource.data.experienceTag == resource.data.experienceTag
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.respondedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt']);

      allow delete: if request.auth != null
        && (request.auth.uid == resource.data.requesterId || request.auth.uid == resource.data.recipientId);
    }

    // =====================================================
    // CIRCULOS DE EXPERIENCE MATCHING — 1 a 8 membros
    // =====================================================
    match /experienceMatchCircles/{circleId} {
      // Allow an eligible user to inspect a circle by ID before joining it.
      // Listing remains restricted to members to avoid exposing other circles.
      allow get: if request.auth != null
        && (
          resource == null
          || request.auth.uid in resource.data.participants
          || (
            get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.active == true
            && resource.data.experienceTag in get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.activeTags
          )
        );
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && request.resource.data.experienceTag is string
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 1
        && request.resource.data.participants[0] == request.auth.uid
        && request.resource.data.capacity == 8
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.active == true
        && request.resource.data.experienceTag in get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.activeTags;

      allow update: if request.auth != null
        && request.resource.data.experienceTag == resource.data.experienceTag
        && request.resource.data.capacity == 8
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.participants is list
        && request.resource.data.participants.size() <= 8
        && request.resource.data.status in ['open','full']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants','status','updatedAt'])
        && (
          (
            !(request.auth.uid in resource.data.participants)
            && request.auth.uid in request.resource.data.participants
            && request.resource.data.participants.size() == resource.data.participants.size() + 1
            && request.resource.data.participants.hasAll(resource.data.participants)
            && get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.active == true
            && resource.data.experienceTag in get(/databases/$(database)/documents/communityMatchProfiles/$(request.auth.uid)).data.activeTags
          )
          || (
            request.auth.uid in resource.data.participants
            && !(request.auth.uid in request.resource.data.participants)
            && request.resource.data.participants.size() == resource.data.participants.size() - 1
            && resource.data.participants.hasAll(request.resource.data.participants)
          )
        )
        && (request.resource.data.participants.size() == 8 ? request.resource.data.status == 'full' : request.resource.data.status == 'open');

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/experienceMatchCircles/$(circleId)).data.participants;
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/experienceMatchCircles/$(circleId)).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    // =====================================================
    // CHATS PRIVADOS
    // =====================================================
    match /chats/{chatId} {

      // ---------------------------------------------------
      // LEITURA INDIVIDUAL DA CONVERSA
      // ---------------------------------------------------
      // Necessário para o getDoc() usado pelo CommunityChat.
      //
      // Se o chat ainda não existir, o utilizador autenticado
      // pode verificar a sua existência.
      //
      // Se já existir, apenas participantes podem lê-lo.
      allow get: if request.auth != null
        && (
          !exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          || request.auth.uid in resource.data.participants
        );

      // ---------------------------------------------------
      // LISTAGEM DE CHATS
      // ---------------------------------------------------
      // Participantes podem listar os seus chats. O campo closedBy só pode ser
      // definido pelo fluxo de encerramento SOS validado abaixo, permitindo ao
      // autor do encerramento localizar os dados para eliminação da conta.
      allow list: if request.auth != null
        && (
          request.auth.uid in resource.data.participants
          || resource.data.closedBy == request.auth.uid
        );


      // ---------------------------------------------------
      // CRIAR CHAT
      // ---------------------------------------------------
      // O chat tem de estar ligado a uma publicação real ou a um pedido
      // de escuta validado; cada pedido de escuta só pode gerar um chat.
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.authorId is string
        && request.resource.data.postId is string
        && (!request.resource.data.keys().hasAny(['listeningRequestId']) || chatId == 'listen_' + request.resource.data.listeningRequestId)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.authorId in request.resource.data.participants
        && (
          validAcceptedExperienceMatch(request.resource.data)
          || validListeningSupportMatch(request.resource.data)
          || request.resource.data.authorId == get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.authorId
        )
        && (
          validAcceptedExperienceMatch(request.resource.data)
          || validListeningSupportMatch(request.resource.data)
          || request.auth.uid == request.resource.data.authorId
          || request.auth.uid in get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.yellowLikedBy
          || request.auth.uid in get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.greenLikedBy
          || request.auth.uid in get(
            /databases/$(database)/documents/posts/$(request.resource.data.postId)
          ).data.redLikedBy
        )
        && (
          validAcceptedExperienceMatch(request.resource.data)
          || validListeningSupportMatch(request.resource.data)
          || request.auth.uid != request.resource.data.authorId
          || (
            (
              request.resource.data.participants[0] == request.resource.data.authorId
              && request.resource.data.participants[1] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.yellowLikedBy
            )
            || (
              request.resource.data.participants[0] == request.resource.data.authorId
              && request.resource.data.participants[1] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.greenLikedBy
            )
            || (
              request.resource.data.participants[0] == request.resource.data.authorId
              && request.resource.data.participants[1] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.redLikedBy
            )
            || (
              request.resource.data.participants[1] == request.resource.data.authorId
              && request.resource.data.participants[0] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.yellowLikedBy
            )
            || (
              request.resource.data.participants[1] == request.resource.data.authorId
              && request.resource.data.participants[0] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.greenLikedBy
            )
            || (
              request.resource.data.participants[1] == request.resource.data.authorId
              && request.resource.data.participants[0] in get(
                /databases/$(database)/documents/posts/$(request.resource.data.postId)
              ).data.redLikedBy
            )
          )
        );


      // ---------------------------------------------------
      // ATUALIZAR CHAT
      // ---------------------------------------------------
      // Apenas participantes podem alterar:
      // - lastMessage
      // - lastMessageAt
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && (
          request.resource.data.lastMessageAt is timestamp
          || request.resource.data.lastMessageAt == null
        )
        && request.resource.data.participants is list
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 2
        && request.resource.data.participants[0] is string
        && (
          request.resource.data.participants.size() == 1
          || (
            request.resource.data.participants[1] is string
            && request.resource.data.participants[0] != request.resource.data.participants[1]
          )
        )
        && (
          !request.resource.data.keys().hasAny(['unreadBy'])
          || (
            request.resource.data.unreadBy is list
            && request.resource.data.unreadBy.size() <= 1
            && (
              request.resource.data.unreadBy.size() == 0
              || request.resource.data.unreadBy[0] in request.resource.data.participants
            )
          )
        )
        && (
          !request.resource.data.keys().hasAny(['lastSenderId'])
          || (
            request.resource.data.lastSenderId is string
            && request.resource.data.lastSenderId in resource.data.participants
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lastMessage',
            'lastMessageAt',
            'lastSenderId',
            'unreadBy',
            'participants',
            'closedAt',
            'closedBy'
          ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['unreadBy'])
          || request.resource.data.unreadBy.size() == 0
          || (
            request.resource.data.lastSenderId == request.auth.uid
            && !(request.auth.uid in request.resource.data.unreadBy)
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['participants'])
          || (
            resource.data.participants.size() == 2
            && request.resource.data.participants.size() == 1
            && !(request.auth.uid in request.resource.data.participants)
            && request.resource.data.participants[0] in resource.data.participants
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['closedAt','closedBy'])
          || (
            resource.data.keys().hasAny(['listeningRequestId'])
            && request.resource.data.closedAt is timestamp
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.closedBy in resource.data.participants
            && request.resource.data.participants.size() == 1
            && !(request.auth.uid in request.resource.data.participants)
            && getAfter(/databases/$(database)/documents/listeningRequests/$(resource.data.listeningRequestId)).data.status == 'closed'
            && getAfter(/databases/$(database)/documents/listeningRequests/$(resource.data.listeningRequestId)).data.closedAt is timestamp
          )
        )
        ;


      // ---------------------------------------------------
      // APAGAR CHAT
      // ---------------------------------------------------
      allow delete: if request.auth != null
        && (
          request.auth.uid in resource.data.participants
          || (
            resource.data.keys().hasAny(['listeningRequestId'])
            && resource.data.closedBy == request.auth.uid
            && resource.data.closedAt is timestamp
          )
        );


      // ===================================================
      // MENSAGENS DO CHAT
      // ===================================================
      match /messages/{messageId} {

        // -------------------------------------------------
        // LER MENSAGENS
        // -------------------------------------------------
        // Apenas participantes da conversa podem ler.
        allow read: if request.auth != null
          && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            || (
              get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['listeningRequestId'])
              && get(/databases/$(database)/documents/chats/$(chatId)).data.closedBy == request.auth.uid
              && get(/databases/$(database)/documents/chats/$(chatId)).data.closedAt is timestamp
            )
          );


        // -------------------------------------------------
        // ENVIAR MENSAGEM
        // -------------------------------------------------
        // Apenas participantes autenticados podem enviar
        // mensagens em seu próprio nome.
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
          && (
            !get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['listeningRequestId'])
            || (
              !get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['closedAt'])
              && get(/databases/$(database)/documents/chats/$(chatId)).data.participants.size() == 2
            )
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;


        // Mensagens não podem ser alteradas
        allow update: if false;


        // -------------------------------------------------
        // APAGAR MENSAGEM
        // -------------------------------------------------
        // Participantes podem apagar mensagens.
        // Moderadores também podem.
        allow delete: if request.auth != null
          && (
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
            || (
              get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAny(['listeningRequestId'])
              && get(/databases/$(database)/documents/chats/$(chatId)).data.closedBy == request.auth.uid
              && get(/databases/$(database)/documents/chats/$(chatId)).data.closedAt is timestamp
            )
            || request.auth.token.moderator == true
          );
      }
    }

    // =====================================================
    // MODERAÇÃO: DENÚNCIAS E BLOQUEIOS
    // =====================================================
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reportedUserId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && (!request.resource.data.keys().hasAny(['circleId']) || request.resource.data.circleId is string)
        && (!request.resource.data.keys().hasAny(['kind']) || request.resource.data.kind is string)
        && (!request.resource.data.keys().hasAny(['circleId']) || (request.auth.uid in get(/databases/$(database)/documents/experienceMatchCircles/$(request.resource.data.circleId)).data.participants && request.resource.data.reportedUserId in get(/databases/$(database)/documents/experienceMatchCircles/$(request.resource.data.circleId)).data.participants));

      allow list, get, delete: if request.auth != null
        && resource.data.reporterId == request.auth.uid;
      allow update: if false;
    }

    match /blocks/{blockId} {
      allow create: if request.auth != null
        && request.resource.data.blockerId == request.auth.uid
        && request.resource.data.blockedUserId is string
        && request.resource.data.blockedUserId != request.auth.uid
        && (!request.resource.data.keys().hasAny(['circleId']) || (request.auth.uid in get(/databases/$(database)/documents/experienceMatchCircles/$(request.resource.data.circleId)).data.participants && request.resource.data.blockedUserId in get(/databases/$(database)/documents/experienceMatchCircles/$(request.resource.data.circleId)).data.participants));

      allow list, get, delete: if request.auth != null
        && resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }
  }
}
