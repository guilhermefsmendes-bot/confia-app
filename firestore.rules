rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================
    // PUBLICAÇÕES DA COMUNIDADE
    // =====================================================
    match /posts/{postId} {

      // Utilizadores autenticados podem ler publicações
      allow read: if request.auth != null;

      // Utilizadores autenticados podem criar publicações
      // apenas em seu próprio nome
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;

      // Utilizadores autenticados podem alterar apenas reações
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'yellowLikes',
            'greenLikes',
            'redLikes',
            'yellowLikedBy',
            'greenLikedBy',
            'redLikedBy'
          ]);

      // O autor pode apagar a própria publicação.
      // Moderadores também podem apagar.
      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.authorId
          || request.auth.token.moderator == true
        );
    }


    // =====================================================
    // CHATS PRIVADOS
    // =====================================================
    match /chats/{chatId} {

      // ---------------------------------------------------
      // LEITURA INDIVIDUAL DA CONVERSA
      // ---------------------------------------------------
      // Necessário para o getDoc() usado pelo CommunityChat.
      //
      // Se o chat ainda não existir, o utilizador autenticado
      // pode verificar a sua existência.
      //
      // Se já existir, apenas participantes podem lê-lo.
      allow get: if request.auth != null
        && (
          !exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          || request.auth.uid in resource.data.participants
        );

      // ---------------------------------------------------
      // LISTAGEM DE CHATS
      // ---------------------------------------------------
      // Apenas participantes podem listar/consultar chats.
      allow list: if request.auth != null
        && request.auth.uid in resource.data.participants;


      // ---------------------------------------------------
      // CRIAR CHAT
      // ---------------------------------------------------
      // O utilizador autenticado:
      // - tem de estar nos participantes
      // - têm de existir exatamente 2 participantes
      // - o authorId tem de ser um dos participantes
      // - o postId tem de existir como texto
      allow create: if request.auth != null
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.authorId is string
        && request.resource.data.authorId in request.resource.data.participants
        && request.resource.data.postId is string;


      // ---------------------------------------------------
      // ATUALIZAR CHAT
      // ---------------------------------------------------
      // Apenas participantes podem alterar:
      // - lastMessage
      // - lastMessageAt
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lastMessage',
            'lastMessageAt'
          ]);


      // ---------------------------------------------------
      // APAGAR CHAT
      // ---------------------------------------------------
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.participants;


      // ===================================================
      // MENSAGENS DO CHAT
      // ===================================================
      match /messages/{messageId} {

        // -------------------------------------------------
        // LER MENSAGENS
        // -------------------------------------------------
        // Apenas participantes da conversa podem ler.
        allow read: if request.auth != null
          && request.auth.uid in
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants;


        // -------------------------------------------------
        // ENVIAR MENSAGEM
        // -------------------------------------------------
        // Apenas participantes autenticados podem enviar
        // mensagens em seu próprio nome.
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;


        // Mensagens não podem ser alteradas
        allow update: if false;


        // -------------------------------------------------
        // APAGAR MENSAGEM
        // -------------------------------------------------
        // Participantes podem apagar mensagens.
        // Moderadores também podem.
        allow delete: if request.auth != null
          && (
            (
              request.auth.uid in
                get(
                  /databases/$(database)/documents/chats/$(chatId)
                ).data.participants
            )
            || request.auth.token.moderator == true
          );
      }
    }
  }
}
